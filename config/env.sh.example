# Site configuration for the NiCf analysis pipeline.
#
#   cp config/env.sh.example config/env.sh    and edit the paths below.
#
# config/env.sh is sourced by run_pipeline.sh and is deliberately NOT tracked by
# git: it is the only file that has to change when the analysis moves to another
# machine. Anything set here can still be overridden on the command line, e.g.
#
#   N_PARTS=5 TRMS_CUT=1.5 ./run_pipeline.sh 1767

# ─── Python environment ──────────────────────────────────────────────────────
# Sourced with `source "${VENV}"` if set; leave empty if Python is already on
# the PATH (conda activate, module load, container, ...).
VENV=/path/to/python_envs/py39_venv/bin/activate
PY=python

# WCTE software tree that provides WCSimFilePackages (the WCSim .npz reader)
# and WCTE_BRB_Data_Analysis (the ROOT part-file helpers). The Python scripts
# add this to sys.path themselves.
export WCTE_SOFTWARE_DIR=/path/to/software/hk

# ─── Inputs ──────────────────────────────────────────────────────────────────
# Directory holding one folder per run with the offline ROOT part-files:
#   ${RAW_DATA_DIR}/<run>/WCTE_offline_R<run>S*P*.root
RAW_DATA_DIR=/path/to/raw_data/production_v0_5

# The geometry files and the multilaterator ship with the repository and are
# picked up automatically from data/ and external/. Uncomment only to override:
#
#   GEO_JSON=/path/to/wcte_v11_20250513.json                  # PMT positions, mm, WCTE frame
#   GEO_FILE=/path/to/geofile_NuPRISMBeamTest_16cShort_mPMT.txt  # tube -> (slot,pos), cm, WCSim frame
#   MPMT_INFO=/path/to/other_mpmt_info.dict                   # In-situ/Ex-situ, TRI/WUT
#   MULTILAT_SCRIPT=/path/to/multilat_vertex_reconstruction.py

# ─── Monte Carlo ─────────────────────────────────────────────────────────────
# Directory holding the WCSim .npz chunks. MC_NPZ_PATTERN is expanded per run
# with %RUN% replaced by the run number; set MC_NPZ directly to bypass it.
MC_NPZ_DIR=/path/to/WCSim/install/npz
MC_NPZ_PATTERN='50Mneutrons_NiCf_piFix_QGSP_BIC_HP_pos%RUN%_CDSON_*events_newTuning.part*.npz'

# ─── Output ──────────────────────────────────────────────────────────────────
# One subdirectory per run is created underneath.
OUTPUT_ROOT=/path/to/analysis_files/final_pipeline_vertex_50M

# ─── Analysis defaults (change only if you know why) ─────────────────────────
# These define the selection. Data and MC are always given the same values, so
# editing one of them here changes both sides consistently.
N_PARTS=25            # data part-files to process
PARTS_PER_CHUNK=5
WINDOW=20             # greedy nHits sliding window [ns]
THRESH_MIN=2          # hits needed inside the window to seed a candidate
TRMS_CUT=2.0          # candidate tRMS cut [ns]
MIN_HITS=6            # minimum hits for the multilateration fit
MAX_NHITS=50          # reject very large pile-up clusters
MIN_L_MM=1000         # minimum vertex->PMT distance in the angular response
N_COS_BINS=100
N_WATER=1.33          # water refractive index used for the ToF correction

# Frame of vertex_x/y/z in the multilaterator CSVs. 'wcsim-cm' is what the
# multilaterator actually produces and is converted to WCTE mm on load;
# 'wcte-mm' uses the numbers unconverted and reproduces the behaviour of
# earlier versions of run_angular_vertex.py.
VERTEX_FRAME=wcsim-cm
